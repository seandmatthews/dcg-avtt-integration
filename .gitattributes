* text=auto
*.bat text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.json text
*.uvtt binary
*.atlasmap text

# Workflow scripts: the loader YAML-parses their metadata block and its parser
# does not accept CRLF (required: true reads as the string "true"). Pin LF
# so merges never rewrite these files through the CRLF checkout filter.
*.dwf.ts text eol=lf
